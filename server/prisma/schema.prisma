// MeetPoint veritabanı şeması (PostgreSQL).
// Geliştirmede gömülü PostgreSQL: npm run db (server/scripts/db.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  locale       String   @default("tr")
  createdAt    DateTime @default(now())

  // Güvenlik
  emailVerifiedAt    DateTime?
  tokenVersion       Int       @default(0) // şifre değişince eski oturumlar geçersiz olur
  isAdmin            Boolean   @default(false) // yönetim ekibinden mi (yetkisi adminRole'de)
  adminRole          String    @default("") // super | moderator | finance
  // Yönetim paneli iki adımlı doğrulama (TOTP). Gizli anahtarlar alan düzeyinde şifreli (fieldCrypto)
  mfaSecret          String    @default("")
  mfaPendingSecret   String    @default("") // kurulum sürerken, ilk kod doğrulanınca mfaSecret olur
  mfaEnabledAt       DateTime?
  mfaLastCounter     Int       @default(0) // aynı kodun ikinci kez kullanılmasını engeller
  mfaBackupCodes     Json      @default("[]") // tek kullanımlık yedek kodların özetleri
  registeredDeviceId String    @default("") // cihaz başına hesap sınırı için
  bannedAt           DateTime?
  banReason          String    @default("")
  termsAcceptedAt    DateTime?
  termsVersion       String    @default("")
  privacyVersion     String    @default("") // okunduğu onaylanan aydınlatma metni sürümü

  // Açık rızaların güncel durumu (her verme/geri alma Consent tablosunda kayıtlı). null = rıza yok
  consentSpecialAt       DateTime? // cinsel yönelim (özel nitelikli veri): eşleştirme için zorunlu
  consentOverseasAt      DateTime? // yurt dışına aktarım: sesli/görüntülü arama ve bildirimler
  consentSelfieAt        DateTime? // mavi tik selfie'si
  consentMarketingAt     DateTime? // kampanya ve duyuru iletişimi (e-posta)
  consentMarketingPushAt DateTime? // kampanya ve duyuru bildirimleri (push)

  // Tüketici (Faz 14): kabul edilen ön bilgilendirme + mesafeli satış sözleşmesi + cayma hakkı istisnası sürümü.
  // Boş veya eski sürümse uygulama satın almadan önce yeniden onay ister.
  salesTermsVersion String @default("")

  // Bildirim tercihleri: kapatılan türler ({ "message": false }) ve sessiz saatler (yerel saat, dakika).
  // Sessiz saatte aramalar dışındaki bildirimler gönderilmez (uygulama içinde görünmeye devam eder).
  notifyPrefs Json @default("{}")
  quietStart  Int? // 0-1439, null = sessiz saat kapalı
  quietEnd    Int?
  tzOffsetMin Int  @default(180) // cihazın UTC farkı (dakika), sessiz saati hesaplamak için

  // Saklama ve imha
  lastActiveAt        DateTime  @default(now()) // 2 yıl hareketsiz hesaplar silinir
  inactivityWarnedAt  DateTime?
  deletionRequestedAt DateTime? // silme talebi: hesap gizlenir, bekleme süresinde girişle geri gelir
  deleteAfter         DateTime?

  // Moderasyon (Faz 12): kısıt süresince mesaj, istek, beğeni, arama ve fotoğraf yükleme kapalı
  restrictedUntil DateTime?

  // Kimlik doğrulama (para çekme için): none | pending | approved | rejected
  kycStatus     String    @default("none")
  kycName       String    @default("") // doğrulanmış ad-soyad (şifreli)
  kycTcHash     String?   @unique // aynı TC ile ikinci hesap para çekemez (özet, TC'nin kendisi değil)
  kycVerifiedAt DateTime?

  // Selfie ile profil doğrulama (mavi tik): none | pending | approved | rejected
  verificationStatus String    @default("none")
  verificationPose   String    @default("") // doğrulama başlatılınca atanan poz
  verifiedAt         DateTime?

  // Jetonla alınan özellikler
  boostedUntil       DateTime? // öne çıkarma bitişi
  likesUnlockedUntil DateTime? // "seni beğenenler" erişimi bitişi

  emailCodes     EmailCode[]
  verifications  VerificationRequest[]
  devices        Device[]
  purchases      Purchase[]
  callsMade      Call[]                @relation("CallCaller")
  callsReceived  Call[]                @relation("CallCallee")
  giftsSent      CallGift[]            @relation("GiftFrom")
  giftsReceived  CallGift[]            @relation("GiftTo")
  payouts        Payout[]
  sessions       Session[]
  consents       Consent[]
  dataExports    DataExport[]
  dsrRequests    DsrRequest[]
  sanctions      Sanction[]
  kycSubmissions KycSubmission[]
  appeals        Appeal[]
  modFlags       ModerationFlag[]
  supportTickets SupportTicket[]
  callDisputes   CallDispute[]

  profile Profile?
  photos  Photo[]

  swipesGiven    Swipe[] @relation("SwipeFrom")
  swipesReceived Swipe[] @relation("SwipeTo")

  wallet        Wallet?
  walletEntries WalletEntry[]

  requestsSent     ContactRequest[] @relation("RequestFrom")
  requestsReceived ContactRequest[] @relation("RequestTo")

  conversationsA Conversation[] @relation("ConvA")
  conversationsB Conversation[] @relation("ConvB")
  messages       Message[]

  blocksGiven    Block[]  @relation("BlockFrom")
  blocksReceived Block[]  @relation("BlockTo")
  reportsGiven   Report[] @relation("ReportFrom")
  reportsAgainst Report[] @relation("ReportTo")

  @@index([registeredDeviceId, createdAt])
  @@index([deleteAfter])
  @@index([lastActiveAt])
}

model Profile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String
  birthDate    DateTime
  gender       String // "male" | "female" | "other"
  interestedIn String // "male" | "female" | "everyone"
  bio          String   @default("")
  city         String   @default("")
  country      String   @default("")
  // Katalog kimlikleri: src/catalog.ts
  interests    Json     @default("[]") // ["coffee", "travel", ...] en fazla 5
  prompts      Json     @default("[]") // [{ id: "perfect_sunday", answer: "..." }] en fazla 3
  // Temel bilgiler (boş = belirtilmemiş)
  lookingFor   String   @default("") // relationship | casual | friendship | chat | unsure
  heightCm     Int?
  job          String   @default("")
  education    String   @default("") // high_school | bachelor | master | phd
  zodiac       String   @default("")
  smoking      String   @default("") // no | sometimes | yes
  drinking     String   @default("") // no | sometimes | yes

  // Konum: gizlilik için ~1 km'ye yuvarlanmış saklanır, kimseye gösterilmez (sadece mesafe)
  latitude   Float?
  longitude  Float?
  locationAt DateTime?

  // Keşfet filtreleri
  filterMinAge Int @default(18)
  filterMaxAge Int @default(80)
  filterMaxKm  Int @default(0) // 0 = mesafe sınırı yok

  updatedAt DateTime @updatedAt

  // Keşfet sorgusu: cinsiyet + yaş aralığı, mesafe kutusu
  @@index([gender, birthDate])
  @@index([latitude, longitude])
}

model Photo {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  position  Int
  // Şüpheli bulunan fotoğraf incelenene kadar sadece sahibine görünür
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, position])
}

model Swipe {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  from      User     @relation("SwipeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("SwipeTo", fields: [toId], references: [id], onDelete: Cascade)
  direction String // "like" | "pass" | "superlike" (jetonla; eşleşme açısından beğeni sayılır)
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@index([toId, direction])
}

// Kullanıcının güncel bakiyesi, 4 kovada (bkz. src/wallet.ts). Her para hareketi bu satırı kilitler.
// Kovalar her zaman WalletEntry kova toplamlarına eşittir (verifyLedger denetler).
model Wallet {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paid        Int      @default(0) // satın alınan: harcanabilir, bozdurulamaz
  promo       Int      @default(0) // hediye/bonus: harcanabilir, bozdurulamaz
  earned      Int      @default(0) // gerçek parayla ödenmiş jetondan kazanç: bozdurulabilir
  earnedPromo Int      @default(0) // promosyon jetondan kazanç: bozdurulamaz
  updatedAt   DateTime @updatedAt
}

// Her para hareketi ayrı satır (denetim izi). amount = kova değişimlerinin toplamı.
model WalletEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int // pozitif = giriş, negatif = çıkış
  type           String // PURCHASE | BONUS | GRANT | DEV_CREDIT | HOLD | REFUND | EARN | SPEND | CALL | GIFT | CASHOUT | CASHOUT_REFUND | CLAWBACK | CALL_REFUND | CALL_REFUND_CLAWBACK | OPENING
  // Kova değişimleri
  paid           Int      @default(0)
  promo          Int      @default(0)
  earned         Int      @default(0)
  earnedPromo    Int      @default(0)
  requestId      String?
  note           String   @default("")
  // Transferde karşı taraf: kazancın kimden geldiği (iade olunca kazancın geri alınabilmesi için)
  counterpartyId String?
  // Bu kazançtan (earned kovası) iade nedeniyle geri alınan jeton
  reclaimedCoins Int      @default(0)
  // Bu kazançtan (earnedPromo kovası) arama iadesi nedeniyle geri alınan jeton (reclaimedCoins'ten
  // ayrı: o alan sadece bozdurulabilir "earned" kovasının olgunlaşma hesabında kullanılıyor)
  reclaimedPromo Int      @default(0)
  // Bu ücretlendirmeden (arama dakikası) arayana zaten iade edilen jeton — aynı dakika iki kez
  // iade edilmesin diye (kısmi iade + sonradan onaylanan itiraz gibi art arda gelebilir)
  refundedCoins  Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([requestId])
  @@index([counterpartyId, createdAt])
}

// Ücretli iletişim isteği: gönderenden jeton bloke edilir,
// kabul edilirse alıcıya EARN olarak geçer, red/süre dolumunda iade edilir.
model ContactRequest {
  id          String    @id @default(cuid())
  fromId      String
  toId        String
  from        User      @relation("RequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          User      @relation("RequestTo", fields: [toId], references: [id], onDelete: Cascade)
  kind        String // MESSAGE | VOICE | VIDEO
  price       Int
  status      String    @default("PENDING") // PENDING | ACCEPTED | REJECTED | CANCELLED | EXPIRED
  note        String    @default("") // MESSAGE isteğindeki ilk mesaj
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@index([toId, status])
  @@index([fromId, status])
}

// İki kullanıcı arasındaki sohbet. Eşleşme (karşılıklı beğeni) veya
// kabul edilen mesaj isteği ile açılır. userAId < userBId (sıralı) tutulur.
model Conversation {
  id        String    @id @default(cuid())
  userAId   String
  userBId   String
  userA     User      @relation("ConvA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("ConvB", fields: [userBId], references: [id], onDelete: Cascade)
  origin    String // MATCH | REQUEST
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([userAId, userBId])
  @@index([userBId]) // "sohbetlerim": userAId eşleşmesi benzersiz indeksle, userBId bununla
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind           String       @default("text") // text | photo
  body           String
  // Güvenlik işareti: contact = telefon/IBAN/sosyal medya paylaşımı (alıcıya uyarı gösterilir)
  flag           String       @default("")
  // Tek seferlik fotoğraf: özel klasörde durur, alıcı bir kez açınca dosya silinir
  photoPath      String?
  viewedAt       DateTime?
  // Faz 15: mesaj teslim garantisi. Alıcının cihazına ulaştı mı (okunmasından önce olur, okunmadan da olabilir)
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Jeton satın alımları (RevenueCat üzerinden App Store / Google Play).
// transactionId benzersiz: aynı mağaza işlemi iki kez jetona dönüşemez.
model Purchase {
  id                String    @id @default(cuid())
  // Hesap silinse de satış kaydı muhasebe için kalır (kullanıcı bağlantısı boşalır)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email             String    @default("") // satın alma anındaki e-posta
  store             String // app_store | play_store | dev
  productId         String
  transactionId     String    @unique
  coins             Int // paketteki jeton
  bonusCoins        Int       @default(0) // ilk alım bonusu
  priceUsd          Float? // mağazanın bildirdiği USD karşılığı (rapor için)
  currency          String    @default("")
  sandbox           Boolean   @default(false)
  status            String    @default("COMPLETED") // COMPLETED | REFUNDED
  // Satın alma anında kabul edilmiş satış metinleri sürümü (cayma hakkı istisnası onayının kanıtı)
  salesTermsVersion String    @default("")
  refundedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Sesli/görüntülü arama. Dakika başı ücret: her dakikanın başında arayanın jetonu
// arananın hesabına (EARN) geçer; bakiye yetmezse arama biter.
model Call {
  id            String     @id @default(cuid())
  callerId      String
  calleeId      String
  caller        User       @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee        User       @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  kind          String // VOICE | VIDEO
  ratePerMin    Int
  status        String     @default("RINGING") // RINGING | ACTIVE | ENDED | MISSED | DECLINED | CANCELLED
  endReason     String     @default("") // hangup | balance | disconnect | server_restart
  billedMinutes Int        @default(0)
  totalCoins    Int        @default(0) // dakika ücretleri toplamı
  giftCoins     Int        @default(0)
  callerRating  Int? // arayanın aranana verdiği puan (1-5)
  calleeRating  Int? // arananın arayana verdiği puan
  createdAt     DateTime   @default(now())
  answeredAt    DateTime?
  endedAt       DateTime?
  gifts         CallGift[]

  // Zamanlayıcı son tarihleri (veritabanında: sunucu yeniden başlasa veya çoğalsa da kaybolmaz)
  ringDeadline  DateTime? // bu ana kadar cevaplanmazsa cevapsız
  nextBillingAt DateTime? // bir sonraki dakikanın ücret anı
  callerGraceAt DateTime? // arayanın bağlantısı koptu: bu ana kadar dönmezse arama biter
  calleeGraceAt DateTime? // arananın bağlantısı koptu

  // Faz 15: adil ücretlendirme. Agora ayarlıysa, iki taraf da gerçekten kanala katılana kadar
  // mediaConfirmDeadline dolar dolmaz arama "bağlantı kurulamadı" sayılıp tüm ücret iade edilir.
  callerJoinedAt       DateTime? // arayan Agora kanalına gerçekten katıldı
  calleeJoinedAt       DateTime? // arayan Agora kanalına gerçekten katıldı
  mediaConfirmDeadline DateTime?
  disputeStatus        String        @default("") // "" | PENDING | APPROVED | REJECTED
  disputes             CallDispute[]

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([status, ringDeadline])
  @@index([status, nextBillingAt])
  @@index([status, mediaConfirmDeadline])
}

// Arama itirazı (Faz 15): kullanıcı geçmişten "bu arama için yanlış ücret alındı" der, panel inceler.
// Onaylanırsa arayana iade edilir; alıcının olgunlaşmamış kazancı geri alınır (refundCallCharge).
model CallDispute {
  id         String    @id @default(cuid())
  callId     String
  call       Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId     String // itirazı açan (arayan ya da alıcı olabilir, ama iade her zaman arayana gider)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  refunded   Int       @default(0) // onaylandıysa iade edilen jeton
  adminNote  String    @default("")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([callId])
}

// Arama içi hediye: jetonun tamamı alıcıya geçer (EARN)
model CallGift {
  id        String   @id @default(cuid())
  callId    String
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  fromId    String
  toId      String
  from      User     @relation("GiftFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("GiftTo", fields: [toId], references: [id], onDelete: Cascade)
  giftId    String
  coins     Int
  createdAt DateTime @default(now())

  @@index([callId])
}

// Para çekme talebi. Talep anında jeton CASHOUT ile düşülür; red/iptalde CASHOUT_REFUND ile geri verilir.
// Ödeme yönetimden elle yapılır (şirket kurulana kadar). Hesap silinse de kayıt muhasebe için kalır.
model Payout {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String // talep anındaki e-posta (hesap silinirse de görünsün)
  coins          Int
  usd            Float
  method         String // iban | paypal
  accountName    String    @default("") // hesap sahibi (şifreli)
  accountHint    String    @default("") // kullanıcıya gösterilen maskeli hâli (•••• 1326)
  accountValue   String // IBAN veya PayPal e-postası
  status         String    @default("PENDING") // PENDING | PAID | REJECTED | CANCELLED
  reference      String    @default("") // yönetimin girdiği havale/işlem numarası
  adminNote      String    @default("") // red sebebi
  // Vergi: brüt (usd) − stopaj = net ödenen
  withholdingUsd Float     @default(0)
  netUsd         Float     @default(0)
  // Dolandırıcılık/limit işaretleri (ör. monthly_cap, same_device, new_account): yönetim dikkatle inceler
  riskFlags      Json      @default("[]")
  exportedAt     DateTime? // toplu EFT dosyasına eklendi
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Hata takibi: uygulamadan gelen ve sunucuda oluşan beklenmeyen hatalar.
// Aynı hata (mesaj + yığının ilk satırları) tek satırda toplanır, sayısı artar.
model ErrorLog {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  source      String // app | server
  platform    String    @default("") // android | ios | web | server
  appVersion  String    @default("")
  message     String
  stack       String    @default("")
  context     String    @default("") // ekran yolu veya istek (GET /discover)
  lastUserId  String    @default("")
  count       Int       @default(1)
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  resolvedAt  DateTime? // çözüldü işaretlenir; tekrar olursa yeniden açılır

  @@index([resolvedAt, lastSeen])
}

// Tekrar gönderilen istek koruması: uygulama her yazma isteğine benzersiz bir anahtar ekler
// (Idempotency-Key). Aynı anahtar tekrar gelirse işlem yeniden yapılmaz, ilk yanıt döner.
model IdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  key            String
  route          String // "POST /calls/:id/gifts" (gerçek yol)
  requestHash    String // aynı anahtar farklı istekle kullanılamaz
  status         String   @default("IN_PROGRESS") // IN_PROGRESS | DONE
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

// Hız sınırlama sayaçları: birden fazla sunucu aynı sayacı paylaşır
model RateLimitHit {
  key     String   @id // sınırlayıcı:anahtar (IP veya kullanıcı)
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}

// Socket.IO PostgreSQL adaptörünün büyük/ikili mesajlar için kullandığı tablo (sunucular arası olaylar).
// Adaptör bu tabloyu kendisi okur/yazar; uygulama kodu kullanmaz.
model SocketIoAttachment {
  id        BigInt   @unique @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  payload   Bytes?

  @@map("socket_io_attachments")
}

// Oturum: her cihaz girişi bir oturumdur. Uygulama 15 dakikalık erişim jetonu + yenileme jetonu
// kullanır; yenileme jetonu her kullanımda değişir, eskisinin tekrar kullanılması çalınma sayılır
// ve oturum kapatılır. 60 gün kullanılmayan oturum kendiliğinden düşer.
model Session {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash     String    @unique // yenileme jetonunun SHA-256 özeti (jetonun kendisi saklanmaz)
  prevRefreshHash String?   @unique
  rotatedAt       DateTime?
  deviceId        String    @default("")
  deviceName      String    @default("")
  platform        String    @default("")
  ip              String    @default("")
  mfa             Boolean   @default(false) // yönetim 2FA'sı bu oturumda doğrulandı
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokeReason    String    @default("")

  @@index([userId, revokedAt])
  @@index([deviceId])
}

// Yönetim işlem kaydı: kim, ne zaman, neyi yaptı. Veritabanı tetikleyicisi değiştirme ve silmeyi
// engeller. Yönetici hesabı silinse de kayıt kalır (bu yüzden kullanıcıya bağlı değil).
model AdminAudit {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String // ör. user.ban, report.resolve, payout.pay, staff.role
  targetType String   @default("")
  targetId   String   @default("")
  details    Json     @default("{}")
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// Push bildirim cihaz jetonları (FCM). ios-voip: PushKit jetonu (Faz 15 · CallKit)
model Device {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String // android | ios | web | ios-voip
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Block {
  fromId    String
  toId      String
  from      User     @relation("BlockFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("BlockTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([fromId, toId])
}

model Report {
  id         String    @id @default(cuid())
  fromId     String
  toId       String
  from       User      @relation("ReportFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to         User      @relation("ReportTo", fields: [toId], references: [id], onDelete: Cascade)
  reason     String
  details    String    @default("")
  status     String    @default("OPEN") // OPEN | RESOLVED
  resolution String    @default("") // dismissed | photo_removed | banned | sanctioned
  priority   Int       @default(3) // 1 = acil (reşit olmayan, müstehcenlik), 2 = yüksek, 3 = normal
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

// E-posta ile gönderilen tek kullanımlık kodlar (doğrulama ve şifre sıfırlama)
model EmailCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // verify | reset
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose, createdAt])
}

// Selfie doğrulama başvurusu: selfie herkese açık değildir, sadece yönetim panelinden görülür
model VerificationRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pose       String
  selfiePath String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note       String    @default("")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

// KVKK: açık rıza ve onay geçmişi (kanıt). Her verme/geri alma yeni satırdır; güncel durum User'da.
model Consent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // terms | privacy | special_category | overseas_transfer | selfie | marketing | marketing_push | sales_terms
  version   String
  granted   Boolean
  source    String   @default("") // register | onboarding | settings | reconsent | verification | seed
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// "Verilerimi indir": sunucu ZIP hazırlar, e-postayla tek kullanımlık bağlantı gider
model DataExport {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("PENDING") // PENDING | READY | DOWNLOADED | EXPIRED | FAILED
  tokenHash    String    @default("")
  path         String    @default("")
  size         Int       @default(0)
  error        String    @default("")
  createdAt    DateTime  @default(now())
  readyAt      DateTime?
  expiresAt    DateTime?
  downloadedAt DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@index([tokenHash])
}

// İlgili kişi başvurusu (KVKK md. 11/13): en geç 30 günde yanıtlanmalı
model DsrRequest {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  kind       String // info | correction | deletion | objection | other
  message    String
  status     String    @default("OPEN") // OPEN | ANSWERED | REJECTED
  dueAt      DateTime
  answer     String    @default("")
  answeredBy String    @default("")
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, dueAt])
}

// İmha kaydı: saklama süresi dolan her veri silinişi (değiştirilemez, silinemez)
model DestructionLog {
  id        String   @id @default(cuid())
  kind      String // account_deleted | inactive_account | email_codes | sessions | data_exports | view_once_photos | ...
  count     Int
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Veri ihlali kayıt defteri (KVKK md. 12/5: Kurula ve ilgililere bildirim)
model BreachRecord {
  id                  String    @id @default(cuid())
  title               String
  description         String
  dataCategories      Json      @default("[]")
  detectedAt          DateTime
  occurredAt          DateTime?
  affectedCount       Int       @default(0)
  measures            String    @default("")
  authorityNotifiedAt DateTime?
  usersNotifiedAt     DateTime?
  usersNotifiedCount  Int       @default(0)
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// 5651: trafik kayıtları. Kullanıcı silinse de saklanır (bağlantısız). Satırlar partiler hâlinde yazılır;
// her parti bir öncekinin özetini içerir (hash zinciri): sonradan değiştirilen/silinen kayıt anlaşılır.
model TrafficLog {
  id        BigInt   @id @default(autoincrement())
  batchId   BigInt
  userId    String   @default("")
  ip        String
  port      Int      @default(0)
  method    String
  path      String
  status    Int      @default(0)
  createdAt DateTime

  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@index([batchId])
}

model TrafficBatch {
  id        BigInt   @id @default(autoincrement())
  count     Int
  rowsHash  String // partideki satırların özeti
  prevHash  String // önceki partinin hash'i
  hash      String // sha256(prevHash + rowsHash + id)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Yaptırım basamakları: warning → restrict_24h → restrict_7d → ban
model Sanction {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String
  reason    String // kural: fake_profile | inappropriate_content | harassment | scam | underage | spam | other
  note      String    @default("") // kullanıcıya gösterilen açıklama
  source    String    @default("") // report:<id> | flag:<id> | auto | manual
  createdBy String // yönetici e-postası veya "system"
  endsAt    DateTime?
  seenAt    DateTime? // kullanıcı bildirimi gördü
  revokedAt DateTime? // itiraz kabul edildi / yönetim kaldırdı
  createdAt DateTime  @default(now())
  appeal    Appeal?

  @@index([userId, createdAt])
}

// Her yaptırıma bir kez itiraz
model Appeal {
  id         String    @id @default(cuid())
  sanctionId String    @unique
  sanction   Sanction  @relation(fields: [sanctionId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  status     String    @default("OPEN") // OPEN | ACCEPTED | REJECTED
  answer     String    @default("")
  decidedBy  String    @default("")
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

// Otomatik güvenlik sinyalleri (şüpheli fotoğraf, iletişim bilgisi paylaşımı, toplu mesaj, tekrarlayan şikayet)
model ModerationFlag {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // photo_suspicious | contact_repeat | spam | report_burst
  refId      String    @default("") // fotoğraf / mesaj kimliği
  details    Json      @default("{}")
  priority   Int       @default(3)
  status     String    @default("OPEN") // OPEN | RESOLVED
  resolution String    @default("") // dismissed | photo_removed | photo_approved | sanctioned
  resolvedBy String    @default("")
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, priority, createdAt])
  @@index([userId, kind, createdAt])
}

// Resmi talepler: 5651 içerik kaldırma, kolluk/savcılık bilgi talebi, mahkeme kararı
model LegalRequest {
  id           String    @id @default(cuid())
  kind         String // takedown | information | court_order | other
  authority    String // talep eden makam
  referenceNo  String    @default("")
  description  String
  subjectUsers Json      @default("[]") // ilgili kullanıcı kimlikleri
  receivedAt   DateTime
  dueAt        DateTime
  status       String    @default("OPEN") // OPEN | DONE | REJECTED
  actions      String    @default("") // yapılan işlemler
  handledBy    String    @default("")
  closedAt     DateTime?
  createdBy    String
  createdAt    DateTime  @default(now())

  @@index([status, dueAt])
}

// Para çekme için kimlik doğrulama başvurusu. Ad-soyad, TC ve belge fotoğrafı şifreli saklanır.
model KycSubmission {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String // şifreli
  tcNo         String // şifreli
  tcHash       String
  documentPath String // özel depoda şifreli görüntü
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note         String    @default("")
  reviewedBy   String    @default("")
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Ekonomi ayarları (tek satır): panelden değiştirilir, sunucular birkaç saniyede güncel değeri okur
model FinanceSettings {
  id                  Int      @id @default(1)
  storeFeeRate        Float    @default(0.15) // mağaza payı (ilk 1M$ için Apple/Google %15)
  vatRate             Float    @default(0.20) // KDV (fiyatlara dahil)
  cashoutUsdPerCoin   Float    @default(0.01) // bozdurma kuru
  cashoutMinCoins     Int      @default(2000)
  withholdingRate     Float    @default(0) // stopaj (muhasebeci belirleyecek)
  maturityDays        Int      @default(14) // kazancın bozdurulabilir olması için bekleme
  monthlyPayoutCapUsd Float    @default(1000) // aylık tavan: aşan talep incelemeye düşer
  usdTryRate          Float    @default(0) // EFT dosyası için varsayılan kur (0 = her seferinde sorulur)
  updatedBy           String   @default("")
  updatedAt           DateTime @updatedAt
}

// Satış paketleri. id = mağazadaki ürün kimliği. usd referans fiyat; tryPrice mağazadaki KDV dahil TL fiyatı (gösterim/rapor).
model CoinPack {
  id        String   @id
  coins     Int
  usd       Float
  tryPrice  Float    @default(0)
  popular   Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ---------- Faz 14: destek, yardım merkezi, künye ----------

// Destek talebi. Durum: OPEN (bizde, yanıt bekliyor) | ANSWERED (kullanıcıda) | CLOSED.
// İlk yanıt hedefi (dueAt) oluşturulurken belirlenir; panelde geciken talepler kırmızı.
model SupportTicket {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String // coins | calls | cashout | safety | account | bug | other
  subject         String
  status          String           @default("OPEN")
  relatedType     String           @default("") // purchase | payout | call | wallet (ilgili işlem)
  relatedId       String           @default("")
  platform        String           @default("") // talep anındaki cihaz (android | ios | web)
  appVersion      String           @default("")
  dueAt           DateTime // ilk yanıt hedefi
  firstResponseAt DateTime?
  lastMessageAt   DateTime         @default(now())
  unreadForUser   Boolean          @default(false) // yanıt geldi, kullanıcı henüz açmadı
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  messages        SupportMessage[]

  @@index([status, dueAt])
  @@index([userId, lastMessageAt])
  @@index([closedAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStaff  Boolean       @default(false)
  staffId    String        @default("") // yanıtlayan ekip üyesi (kullanıcıya "MeetPoint Destek" görünür)
  body       String
  attachment String        @default("") // ekran görüntüsü (özel depo anahtarı)
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// Yardım merkezi (SSS). Panelden düzenlenir; uygulamada ve web'de (/help) gösterilir.
model HelpArticle {
  id        String   @id @default(cuid())
  locale    String // tr | en
  category  String // coins | calls | cashout | safety | account
  question  String
  answer    String
  position  Int      @default(0)
  published Boolean  @default(true)
  updatedBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, published, category, position])
}

// Künye (satıcı/hizmet sağlayıcı bilgileri): uygulamada, web'de ve yasal metinlerde gösterilir.
// Şirket kurulunca panelden doldurulur (Faz 17); boş alanlar metinlerde köşeli parantezle görünür.
model CompanyInfo {
  id         Int      @id @default(1)
  legalName  String   @default("") // ticaret unvanı
  mersisNo   String   @default("")
  taxOffice  String   @default("")
  taxNo      String   @default("")
  address    String   @default("")
  kepAddress String   @default("")
  email      String   @default("") // destek e-postası
  kvkkEmail  String   @default("") // KVKK başvuru e-postası
  phone      String   @default("")
  etbisNo    String   @default("") // e-ticaret bilgi sistemi kaydı
  verbisNo   String   @default("")
  updatedBy  String   @default("")
  updatedAt  DateTime @updatedAt
}
