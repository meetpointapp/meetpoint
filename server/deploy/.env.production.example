# Yayın ortamı. Kopyala: /opt/vibeupme/server/.env (izin: chmod 600). Ayrıntı: docs/yayin-sunucu-kurulumu.md
NODE_ENV=production
PORT=4000
PUBLIC_URL=https://api.vibeupme.com
CORS_ORIGINS=https://vibeupme.com

# Prisma bağlantı havuzu: süreç başına 15 (3 süreç = 45 bağlantı)
DATABASE_URL="postgresql://vibeupme:PAROLA@127.0.0.1:5432/vibeupme?connection_limit=15&pool_timeout=20"
PG_POOL_MAX=4

# Redis (hız sınırı, Socket.IO, çevrimiçi durum)
REDIS_URL=redis://:PAROLA@127.0.0.1:6379

# Fotoğraflar: S3 uyumlu depolama (Cloudflare R2 önerilir: çıkış trafiği ücretsiz). İki ayrı kova açın.
S3_ENDPOINT=https://HESAP_KIMLIGI.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=vibeupme-public
S3_PRIVATE_BUCKET=vibeupme-private

JWT_SECRET=
MEDIA_URL_SECRET=
FIELD_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
REVENUECAT_WEBHOOK_AUTH=
AGORA_APP_ID=
AGORA_APP_CERT=
FIREBASE_SERVICE_ACCOUNT=/opt/vibeupme/secrets/firebase.json
