# MeetPoint sunucu ayarları. Kopyala: cp .env.example .env
# Geliştirmede sadece ilk üçü yeterli; diğerleri boşsa ilgili özellik test modunda çalışır.

# Geliştirmede gömülü PostgreSQL: ayrı bir terminalde "npm run db" açık olmalı
DATABASE_URL="postgresql://meetpoint:meetpoint-dev@localhost:5433/meetpoint"
JWT_SECRET="en-az-32-karakterlik-uzun-rastgele-bir-metin"
PORT=4000

# Yayında: production modunda eksik zorunlu ayar varsa sunucu açılmaz
# NODE_ENV=production

# E-posta (doğrulama ve şifre sıfırlama kodları). Boşsa kodlar dev-mails/ klasörüne yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MeetPoint <no-reply@meetpoint.app>"

# Push bildirimleri: Firebase servis hesabı JSON dosyasının yolu
FIREBASE_SERVICE_ACCOUNT=

# Ödeme (RevenueCat): webhook yetki başlığı ve REST gizli anahtarı
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=

# Sesli/görüntülü arama (Agora). Boşsa aramalar test modunda (ses/görüntü yok).
AGORA_APP_ID=
AGORA_APP_CERT=

# Arama zamanlamaları (saniye). Varsayılanlar: 60 / 45 / 20
# CALL_BILLING_SECONDS=60
# CALL_RING_SECONDS=45
# CALL_DISCONNECT_GRACE_SECONDS=20

# Zamanlayıcı (ms). Birden fazla sunucuda yalnızca biri lider olur ve zamanlanmış işleri yapar.
# SCHEDULER_TICK_MS=1000
# LEADER_RETRY_MS=5000
# PRESENCE_SWEEP_MS=10000

# Doğrudan PostgreSQL bağlantı havuzu (anlık olaylar ve liderlik kilidi için; Prisma'dan ayrı)
# PG_POOL_MAX=12

# Fotoğraf adreslerini imzalayan gizli anahtar (boşsa JWT_SECRET'tan türetilir)
# MEDIA_URL_SECRET=

# Dosya klasörleri
# UPLOAD_DIR=uploads
# PRIVATE_UPLOAD_DIR=private-uploads

# --- Güvenlik (Faz 10) ---
# IBAN / PayPal ve 2FA anahtarlarını şifreleyen anahtar (32 bayt, base64). Yayında zorunlu, kaybetme!
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Tarayıcıdan erişime izin verilen adresler (virgülle). Yayında zorunlu. Ör: https://admin.meetpoint.app
CORS_ORIGINS=
# Kayıtta bot koruması (Cloudflare Turnstile). Boşsa kapalı.
TURNSTILE_SECRET=
# Erişim jetonu ömrü (sn) ve hareketsiz oturumun düşme süresi (gün)
ACCESS_TOKEN_SECONDS=900
SESSION_IDLE_DAYS=60
# Aynı cihazdan 30 günde açılabilecek hesap sayısı
ACCOUNTS_PER_DEVICE=3
# Sızdırılmış şifre kontrolü (Have I Been Pwned). "off" ile kapatılır.
PASSWORD_BREACH_CHECK=on
# Ek API sunucusunda zamanlayıcıyı kapatmak için: SCHEDULER=off

# --- KVKK (Faz 11) ---
# Sunucunun dışarıdan görünen adresi (e-postadaki "verilerimi indir" bağlantıları). Yayında zorunlu.
PUBLIC_URL=http://localhost:4000
# Yurt dışı aktarım için ayrı rıza ("off": standart sözleşme yeterli görülürse)
# OVERSEAS_CONSENT=on
# Saklama süreleri (gün) ve imha işinin aralığı (ms)
# DELETION_GRACE_DAYS=30
# INACTIVE_DAYS=730
# RETENTION_INTERVAL_MS=3600000

# --- Moderasyon ve 5651 (Faz 12) ---
# Trafik kayıtlarının saklama süresi (gün) ve yazma aralığı (ms)
# TRAFFIC_LOG_DAYS=730
# TRAFFIC_FLUSH_MS=2000
# Şüpheli profil fotoğrafı için ten oranı eşiği (0-1)
# PHOTO_SKIN_THRESHOLD=0.6

# --- Finans (Faz 13) ---
# Oranlar, paketler, stopaj, olgunlaşma ve aylık tavan panelden (Finans → Ekonomi) yönetilir.
# Sunucuların ayarları önbellekte tutma süresi (ms)
# FINANCE_CACHE_MS=5000

# --- Tüketici ve destek (Faz 14) ---
# Destek taleplerinde yanıt hedefi (saat)
# SUPPORT_SLA_HOURS=48
# Mağaza incelemesi demo hesabı (npm run review:account; şifre REVIEW_ACCOUNT_PASSWORD ile verilir, .env'e yazma)
# REVIEW_ACCOUNT_EMAIL=review@meetpoint.app
