# MeetPoint sunucu ayarları. Kopyala: cp .env.example .env
# Geliştirmede sadece ilk üçü yeterli; diğerleri boşsa ilgili özellik test modunda çalışır.

# SQLite tek yazıcılıdır: tek bağlantı eşzamanlı işlemlerde kilitlenmeyi önler (PostgreSQL'e geçince kalkar)
DATABASE_URL="file:./dev.db?connection_limit=1"
JWT_SECRET="en-az-32-karakterlik-uzun-rastgele-bir-metin"
PORT=4000

# Yayında: production modunda eksik zorunlu ayar varsa sunucu açılmaz
# NODE_ENV=production

# E-posta (doğrulama ve şifre sıfırlama kodları). Boşsa kodlar dev-mails/ klasörüne yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MeetPoint <no-reply@meetpoint.app>"

# Push bildirimleri: Firebase servis hesabı JSON dosyasının yolu
FIREBASE_SERVICE_ACCOUNT=

# Ödeme (RevenueCat): webhook yetki başlığı ve REST gizli anahtarı
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=

# Sesli/görüntülü arama (Agora). Boşsa aramalar test modunda (ses/görüntü yok).
AGORA_APP_ID=
AGORA_APP_CERT=

# Arama zamanlamaları (saniye). Varsayılanlar: 60 / 45 / 20
# CALL_BILLING_SECONDS=60
# CALL_RING_SECONDS=45
# CALL_DISCONNECT_GRACE_SECONDS=20

# Dosya klasörleri
# UPLOAD_DIR=uploads
# PRIVATE_UPLOAD_DIR=private-uploads
